# Used instead of the root .dockerignore when building with
# Dockerfile.allinone (BuildKit picks up "<dockerfile-name>.dockerignore"
# automatically) -- the root one excludes backend/ and config/, written
# for the frontend-only root Dockerfile, but this image needs both.

.git/
.github/

node_modules
.next/
out/
build

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.env
.env.*
!.env.example

.vercel
*.tsbuildinfo
next-env.d.ts

docs/
README.md

backend/.venv
backend/**/__pycache__
backend/**/*.pyc
backend/data_lake
backend/data_lake_backups
backend/audit_archive
backend/secrets
