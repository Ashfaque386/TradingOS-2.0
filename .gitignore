# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python / backend
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
# Redis persistence snapshot -- lands wherever redis-server's cwd happens
# to be when it dumps (backend/ under docker-compose, repo root if run
# ad hoc for local testing), so this is unanchored rather than pinned to
# one path.
dump.rdb

# Next.js 16 auto-generates these on every `next dev`/`next build` start
# (framework tooling boilerplate, not project content) -- the real project
# doc lives at docs/CLAUDE.md.
/AGENTS.md
/CLAUDE.md
