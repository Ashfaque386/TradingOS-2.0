# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# Claude Code's own tooling scratch space (e.g. isolated worktrees it
# creates for background subagents) -- local runtime state, not project
# content.
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# python / backend
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
# mutmut (Build Spec §21-22 mutation testing, see backend/pyproject.toml's
# [tool.mutmut]) working copy + cache -- local run artifacts, not project
# content.
backend/mutants/
backend/.mutmut-cache
# Redis persistence snapshot -- lands wherever redis-server's cwd happens
# to be when it dumps (backend/ under docker-compose, repo root if run
# ad hoc for local testing), so this is unanchored rather than pinned to
# one path.
dump.rdb
# Encrypted broker-credentials store (src/security/secrets_store.py,
# Build Spec §3/§20) -- local runtime state (e.g. seeded for the e2e
# Playwright suite's live-intent-approval spec), never committed even
# though it's encrypted at rest.
backend/secrets/
# WORM-style local audit archive (src/audit/archive.py) -- real audit
# entries generated by local dev/e2e runs, not project content.
backend/audit_archive/
# DuckDB + Parquet data lake and its backup (src/data/lake.py, Build
# Spec §14) -- local runtime data generated by running backtests/data
# ingestion, not project content.
backend/data_lake/
backend/data_lake_backups/

# Playwright's own run artifacts (screenshots/traces/HTML report from
# e2e/ -- see playwright.config.ts) -- local test output, not project
# content.
/test-results/
/playwright-report/

# Next.js 16 auto-generates these on every `next dev`/`next build` start
# (framework tooling boilerplate, not project content) -- the real project
# doc lives at docs/CLAUDE.md.
/AGENTS.md
/CLAUDE.md
