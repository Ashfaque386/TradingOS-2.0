# Copy to .env for running the API outside Docker Compose (e.g. `uvicorn
# src.main:app --reload`), pointed at a Postgres instance you run yourself.

ENV=development
DATABASE_URL=postgresql+asyncpg://tradingos:tradingos@localhost:5432/tradingos

# Event bus Redis publish (src/orchestration/events.py). The default
# already matches a local `redis-server` on the standard port; only
# override if yours runs somewhere else.
#REDIS_URL=redis://localhost:6379/0

# Monte Carlo distribution (src/engine/optimization/temporal_workflows.py).
# The default already matches a local Temporal dev server
# (`temporal server start-dev`) on its standard port; only override if
# yours runs somewhere else.
#TEMPORAL_ADDRESS=localhost:7233

JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origins the CORS policy accepts requests from. The default matches
# `pnpm dev`'s own default port (3000); if your frontend is running
# somewhere else (a different port, or `pnpm docker:up`'s auto-picked
# one), add it here -- comma-separated for more than one. A blocked
# origin shows up in the frontend as a generic "connectivity error", not
# a CORS error, so this is easy to misdiagnose as the backend being down.
#CORS_ORIGINS=http://localhost:3000

# The default (config/tradingos.config.json, relative to CWD) is correct
# for the single Docker container, not for `uvicorn` run locally from
# backend/ — override it to the real repo-root config/ directory:
AGENT_GATEWAY_CONFIG_PATH=../config/tradingos.config.json

# Same relative-to-CWD override, for the Phase 10 NSE movable-holiday
# reference file (src/data/nse_calendar.py):
NSE_HOLIDAYS_PATH=../config/nse_holidays.json

# Broker credentials store (Build Spec §3, §20) -- required before any
# broker-credentials write or Shadow Mode check will work; without it the
# paper trading engine still runs fine against its mock tick feed.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#SECRETS_ENCRYPTION_KEY=
#SECRETS_STORE_PATH=secrets/broker_credentials.enc

# Paper trading runs on real market data only; see the repo-root .env.example for the full list of
# PAPER_* tunables (tick and depth age limits, futures margin and roll, options expiry rules, cost
# overrides). They are read from here when the backend is run directly with uvicorn.
#PAPER_TRADING_SYNTHETIC=false
#PAPER_TICK_MAX_AGE_SECONDS=20
#PAPER_STALE_PRICE_SECONDS=120
#PAPER_QUOTE_MAX_EXCHANGE_AGE_SECONDS=0

# Engine alerts: seconds a warning must last before anyone is messaged; Alertmanager's address
# (empty = none) and where the webhook token lives (created on first boot).
#ENGINE_ALERT_CONFIRM_SECONDS=120
#ALERTMANAGER_URL=
#ALERTMANAGER_TOKEN_PATH=alertmanager_token/webhook_token

# Nightly Postgres backup: folder (relative to the working directory), what is kept, when it runs
# (IST) and when Settings calls the newest backup too old. See the repo-root .env.example.
#POSTGRES_BACKUP_PATH=backups
#POSTGRES_BACKUP_KEEP_COUNT=7
#POSTGRES_BACKUP_RETENTION_DAYS=14
#POSTGRES_BACKUP_HOUR_IST=22
#POSTGRES_BACKUP_MINUTE_IST=45
#BACKUP_STALE_AFTER_HOURS=36

# Sign-in (src/api/routes/auth.py); see the repo-root .env.example for the full notes. Registration is for the very first account only; after that an
# administrator creates accounts (Settings > Users). A wrong password counts against the account it was
# tried on: LOGIN_MAX_FAILED_ATTEMPTS of them within LOGIN_FAILURE_WINDOW_MINUTES lock it for
# LOGIN_LOCKOUT_MINUTES (an administrator can unlock it sooner). LOGIN_RATE_LIMIT_PER_MINUTE is the
# separate ceiling on sign-in attempts from one address.
#LOGIN_MAX_FAILED_ATTEMPTS=5
#LOGIN_FAILURE_WINDOW_MINUTES=15
#LOGIN_LOCKOUT_MINUTES=15
#LOGIN_RATE_LIMIT_PER_MINUTE=20
# The refresh token is an HttpOnly cookie, never in a response body or in storage the page can read.
# auto marks it Secure when the request came over HTTPS (directly, or via a TRUSTED_PROXIES proxy that
# said so). SameSite strict suits a console on the same site as the API (localhost:3000 and :8000 are
# one site); a console on another site needs none, which browsers only accept together with Secure.
#REFRESH_COOKIE_SECURE=auto
#REFRESH_COOKIE_SAMESITE=strict
# A WebSocket is opened with a one-time ticket bought with the access token; it lives this long.
#WS_TICKET_TTL_SECONDS=30
# A refresh retires the old token. If the browser never got the reply (a reload cancelled it), it
# presents the retired token again: within this many seconds, and while its replacement was never
# used, that gets a fresh token instead of ending the session. After that a retired token is a
# replay and ends every session of the family. 0 turns the allowance off.
#REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are believed: addresses or CIDR blocks,
# comma-separated. Empty (the default) believes none, so a client cannot pick the address it is
# rate-limited under by sending that header. Set it when this API sits behind nginx/Caddy/a load
# balancer, or every request will look like it came from the proxy.
#TRUSTED_PROXIES=
# FastAPI's /docs, /redoc and /openapi.json. Off unless asked for.
#API_DOCS_ENABLED=false
# Strict-Transport-Security on API responses. Only when the API is served over HTTPS.
#HSTS_ENABLED=false
