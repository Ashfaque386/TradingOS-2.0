# Copy to .env for running the API outside Docker Compose (e.g. `uvicorn
# src.main:app --reload`), pointed at a Postgres instance you run yourself.

ENV=development
DATABASE_URL=postgresql+asyncpg://tradingos:tradingos@localhost:5432/tradingos

# Event bus Redis publish (src/orchestration/events.py). The default
# already matches a local `redis-server` on the standard port; only
# override if yours runs somewhere else.
#REDIS_URL=redis://localhost:6379/0

# Monte Carlo distribution (src/engine/optimization/temporal_workflows.py).
# The default already matches a local Temporal dev server
# (`temporal server start-dev`) on its standard port; only override if
# yours runs somewhere else.
#TEMPORAL_ADDRESS=localhost:7233

JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# The default (config/tradingos.config.json, relative to CWD) is correct
# for the single Docker container, not for `uvicorn` run locally from
# backend/ — override it to the real repo-root config/ directory:
AGENT_GATEWAY_CONFIG_PATH=../config/tradingos.config.json
