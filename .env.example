# Copy to .env and adjust for a real deployment. docker compose up works
# with none of this set — these are the defaults baked into docker-compose.yml.

POSTGRES_USER=tradingos
POSTGRES_PASSWORD=tradingos
POSTGRES_DB=tradingos

# Leave this unset and a random signing key is generated at first start and kept
# in the database (which wins over this file from then on). Set it only to carry
# an existing key over; anything shorter than 32 bytes, or the old placeholder
# `change-me-in-production`, is ignored and replaced. To replace a key later:
# Settings > Security > Rotate. To generate one yourself:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ENV=development

# Host interface the backend/frontend/Prometheus/Grafana ports below are
# published on (Build Spec §21-22 hardening pass). Defaults to loopback
# only -- these ports serve the entire Agent Gateway config/CLI-mutation
# surface, the human Console, and (for Grafana) a default admin/admin
# login, so none of them should be reachable from other machines on your
# network by default. Set this to 0.0.0.0 (every interface) or a specific
# interface IP only if you deliberately want that, e.g. reaching the
# Console from another device on your own LAN.
#BIND_HOST=127.0.0.1

# Host-side port the backend container's API (8000) is published on. Change
# it if 8000 is already taken on your machine -- or use `pnpm docker:up`
# (scripts/docker-up.js), which finds a free port for every service
# automatically and sets this (and the other *_HOST_PORT vars below) for you.
#API_HOST_PORT=8000

# Host-side port the frontend container's Next.js app (3000) is published
# on. Change it if 3000 is already taken on your machine.
#FRONTEND_HOST_PORT=3000

# Where the browser (not the frontend container) reaches the backend API
# and its WebSocket channels. These are baked into the frontend's JS bundle
# at build time (Next.js NEXT_PUBLIC_* convention), so changing them takes
# effect only on a rebuild -- `pnpm docker:up` always rebuilds, so this is
# automatic there. Default to API_HOST_PORT's own value, so they track it
# automatically; set these directly only if the browser needs to reach the
# backend by a different host than "localhost" (e.g. a LAN IP).
#NEXT_PUBLIC_API_URL=http://localhost:8000
#NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Origins the backend's CORS policy accepts requests from -- must include
# wherever the frontend is actually served from, or the browser silently
# blocks every API/WebSocket call (reported by the frontend as a generic
# "connectivity error", not a CORS error). Comma-separated for more than
# one. Defaults to FRONTEND_HOST_PORT's own value, so it tracks the
# frontend's actual port automatically (including when `pnpm docker:up`
# bumps it to avoid a conflict) -- set this directly only to allow origins
# beyond "localhost:<port>" (e.g. a LAN IP or a real domain).
#CORS_ORIGINS=http://localhost:3000

# Postgres is NOT published to the host by default (it's reached over
# localhost from inside the same container regardless, so it never needs
# to be) — this is what makes `docker compose up` immune to the classic
# "port 5432 already allocated" conflict after a `git pull`. To connect a
# host tool (psql, a GUI client) directly, opt in to the override file
# (loopback-only via BIND_HOST, host port POSTGRES_HOST_PORT, default 5433):
#COMPOSE_PATH_SEPARATOR=,
#COMPOSE_FILE=docker-compose.yml,docker-compose.postgres-port.yml
#POSTGRES_HOST_PORT=5433

# Host-side port Prometheus's own UI (9090) is published on.
#PROMETHEUS_HOST_PORT=9090

# Host-side port Grafana's UI (internally 3000) is published on. Defaults
# to 3001, not 3000 — 3000 is already the frontend's default.
#GRAFANA_HOST_PORT=3001

# Grafana admin login. Defaults to admin/admin (Grafana forces a password
# change on first real login) — set a real password for anything beyond
# local dev.
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin

# Optional: set both to have the container ensure this SystemAdministrator
# user exists on every boot (idempotent — creates it once, then just
# leaves it alone). Unset by default so a stock deployment never has a
# credential baked in. Without this, register the first user through the
# app instead — the very first registered user automatically becomes
# SystemAdministrator.
#DEFAULT_ADMIN_EMAIL=admin@example.com
#DEFAULT_ADMIN_PASSWORD=change-me

# Required before the Settings UI's Broker Config, LLM Providers, or
# Notification Channels panels will work — all three share this one
# encrypted-at-rest secrets store (Fernet key). Nothing else needs it:
# paper trading, backtests, and every other feature run fine without it.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The backend logs a startup warning (not a crash) if this is left unset.
#SECRETS_ENCRYPTION_KEY=

# Agent long-term vector memory (backlog item 18). docker-compose.yml runs a
# Qdrant service and points the backend at it (QDRANT_URL defaults to
# http://qdrant:6333). The embedding provider + model are best chosen in
# Mission Control > Agent memory (SystemAdministrator): that choice is saved in
# the database, so it survives restarts and rebuilds without touching this
# file. The two variables below are only the fallback used when nothing has
# been saved there. There is deliberately no built-in embedder, so until a
# model is chosen the panel reports memory as unavailable and pipeline runs
# proceed without recalled lessons. Provider is one of ollama | openai |
# gemini | custom and reuses that provider's credentials from Settings > LLM
# providers (or OPENAI_API_KEY / GEMINI_API_KEY). For Ollama, pull the model
# first (`ollama pull nomic-embed-text`). Changing the model later changes the
# vector size; the backend then reports a dimension mismatch rather than
# mixing the two.
#MEMORY_EMBEDDING_PROVIDER=ollama
#MEMORY_EMBEDDING_MODEL=nomic-embed-text

# Paper trading runs on REAL market data only: with no broker connected, or too little ingested
# history for a symbol, that subscription waits instead of trading on generated prices.
# Set true only for a demo or the automated tests -- never for results meant to be believed.
#PAPER_TRADING_SYNTHETIC=false

# Paper-trading tunables. Every one is forwarded to the backend by docker-compose.yml with the
# default shown here; uncomment to change it (src/core/config.py explains each in full).
# How fills are charged: cnc (delivery, positions held overnight) or mis (intraday).
#PAPER_TRADING_PRODUCT=cnc

# What the live account started with, in rupees. The automatic live kill switch measures the fall
# from the highest equity against this; unset, live equity is reported as 'cannot be measured' and
# the live switch is never tripped by a guess.
#LIVE_STARTING_CAPITAL=
# The oldest order book (seconds) a paper fill will walk; an older one makes the order wait.
#PAPER_DEPTH_MAX_AGE_SECONDS=30
# The oldest tick (seconds) the engine will act on. Quotes are fetched every 3 s and drained
# every 5 s, so ticks are routinely up to ~8 s old; this is the bound beyond which the feed has
# stalled. Tune it from the "Paper ticks: age" Grafana panel once a session has run.
#PAPER_TICK_MAX_AGE_SECONDS=20
# Ticks kept per symbol (about one day at the default).
#PAPER_TICK_STREAM_MAXLEN=10000
# Futures: margin is an ESTIMATE (a flat share of notional, not SPAN); an entry may commit at most
# the stated share of the subscription's capital; a future is rolled this many days before expiry.
#PAPER_FUTURES_MARGIN_PCT=15
#PAPER_FUTURES_MAX_MARGIN_UTILISATION_PCT=50
#PAPER_FUTURES_ROLL_DAYS=3
# Options: open only in a contract with more than this many days left; square off this many days
# before expiry; how long a chosen set of legs is quoted before it is chosen again.
#PAPER_OPTIONS_MIN_DAYS_TO_EXPIRY=3
#PAPER_OPTIONS_SQUAREOFF_DAYS=1
#PAPER_OPTIONS_PLAN_TTL_SECONDS=300
# A published cost rate that changed, as JSON over the friction model's fields.
#PAPER_FRICTION_OVERRIDES={"futures_stt_sell_pct": 0.0002}
