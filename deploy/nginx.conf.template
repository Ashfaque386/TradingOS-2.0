# Rendered to /etc/nginx/conf.d/tradingos.conf by allinone-entrypoint.sh
# (envsubst on ${PORT} only -- every other $-prefixed name here is an
# nginx variable, not a shell one, and must survive that substitution
# untouched).
#
# This is the one process in the all-in-one image that's actually reachable
# from outside the container. It serves the frontend and backend from a
# single origin, which is what makes the rest of the image config-free:
# the browser never makes a cross-origin request, so there is no
# NEXT_PUBLIC_API_URL/WS_URL to bake in at build time and no CORS_ORIGINS
# to keep in sync with wherever the platform happens to publish this
# service -- see lib/api.ts's/lib/ws.ts's same-origin fallback.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# What the client's connection to the platform in front of this container used: a platform that
# terminates TLS says so in X-Forwarded-Proto, and the API marks its session cookie Secure from it.
# Without a platform in front, this container's own scheme.
map $http_x_forwarded_proto $forwarded_scheme {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT};
    server_name _;

    client_max_body_size 20m;

    # Covers both REST (/api/v1/...) and the WebSocket channels mounted
    # under the same prefix (src/api/router.py) -- the Upgrade/Connection
    # headers below are inert for plain HTTP requests and required for WS.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # $http_host, not $host: it keeps the port, and the API compares it with the browser's Origin
        # (a request from the page this host serves) before it lets the session cookie be used.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        proxy_read_timeout 3600s;
    }

    location /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # The console's Content-Security-Policy names this host for its own WebSocket (proxy.ts).
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    }
}
