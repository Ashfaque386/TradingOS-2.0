{
  "version": 1,
  "infra": {
    "llmProviders": {
      "order": [
        "deepseek",
        "ollama",
        "anthropic",
        "gemini",
        "openai"
      ],
      "fallbackPolicy": "next-on-failure"
    },
    "brokerFailover": {
      "primary": "zerodha",
      "fallback": "upstox"
    },
    "riskThresholdRefs": {
      "maxDrawdownPct": 15.0,
      "wsLatencyMs": 100.0
    }
  },
  "agents": {
    "defaults": {
      "model": "auto",
      "heartbeatEnabled": false,
      "skills": [
        "market-data-read",
        "notification-send"
      ]
    },
    "entries": {
      "ceo-agent": {
        "identity": {
          "name": "CEO",
          "emoji": "🧠",
          "theme": "cyan"
        },
        "heartbeatEnabled": true,
        "heartbeatIntervalMinutes": 10
      },
      "risk-manager": {
        "identity": {
          "name": "Risk Manager",
          "emoji": "🛡️",
          "theme": "amber"
        },
        "heartbeatEnabled": true,
        "heartbeatIntervalMinutes": 5
      }
    }
  },
  "bindings": [
    {
      "agentId": "ceo-agent",
      "match": {
        "channel": "telegram",
        "accountId": "ops"
      }
    }
  ],
  "agentToAgentPolicy": {
    "default": "deny",
    "allow": [
      {
        "from": "risk-manager",
        "to": "ceo-agent",
        "scope": "read-artefacts"
      }
    ]
  }
}
